enum Gender {
    MALE
    FEMALE
}

enum Role {
    USER
    ADMIN
    SUPER_ADMIN
}

model User {
    id                  String               @id @default(cuid())
    name                String
    email               String               @unique
    password            String?
    emailVerified       Boolean?
    image               String?
    posts               Post[]
    savedPosts          SavePost[]
    cover               String?
    bio                 String?
    username            String?              @unique
    gender              Gender?
    isPermanentlyBanned Boolean              @default(false)
    banExpiresAt        DateTime?
    banReason           String?
    lastSeenAt          DateTime             @default(now())
    nickname            String?
    postsCount          Int                  @default(0)
    friendsCount        Int                  @default(0)
    followersCount      Int                  @default(0)
    followingCount      Int                  @default(0)
    role                Role                 @default(USER)
    professionalMode    Boolean              @default(false)
    education           String?
    jobTitle            String?
    likes               Like[]
    comments            Comment[]
    likeForComments     LikeForComment[]
    city                String?
    socialLinks         SocialLink[]
    stories             Story[]
    hiddenPosts         HiddenPost[]
    blocks              Block[]              @relation("Blocker")
    blocked             Block[]              @relation("Blocked")
    friends             Friendship[]         @relation("Friends")
    friendships         Friendship[]         @relation("MyFriendships")
    storyViewers        StoryViewer[]
    sender              FriendRequest[]      @relation("Sender")
    receiver            FriendRequest[]      @relation("Receiver")
    followers           Follow[]             @relation("Following")
    followings          Follow[]             @relation("Follower")
    conversationMember  ConversationMember[]
    messages            Message[]

    @@map("users")
}
